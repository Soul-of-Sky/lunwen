%%{init: {"flowchart": {"defaultRenderer": "elk"}} }%%
graph LR
    %% --- 样式定义 ---
    %% 统一给 Physical 内部节点设置固定宽度，强制其变窄
    classDef logical fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000,font-size:18px;
    classDef ftl fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,color:#000,font-size:18px;
    classDef valid fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000,font-size:18px;
    classDef invalid fill:#ffcdd2,stroke:#c62828,stroke-width:2px,color:#000,font-size:18px;
    classDef empty fill:#ffffff,stroke:#bdbdbd,stroke-width:2px,stroke-dasharray: 5 5,color:#757575,font-size:18px;

    subgraph Host ["<div style='min-width:180px; margin-bottom:20px; font-size:22px; font-weight:bold;'>逻辑视图</div>"]
        LBA[逻辑页 LBA: A]:::logical
    end

    subgraph Controller ["<div style='min-width:220px; margin-bottom:20px; font-size:22px; font-weight:bold;'>闪存转换层 FTL</div>"]
        MapTable[映射表更新 <br> LBA A -> P_new]:::ftl
    end

    %% 调小 min-width，并确保内部节点不会撑得太开
    subgraph Physical ["<div style='min-width:240px; margin-bottom:20px; font-size:22px; font-weight:bold;'>物理块</div>"]
        direction TB
        P_Old[物理页 P_old <br> 旧数据: 已失效]:::invalid
        P_New[物理页 P_new <br> 新数据: 已写入]:::valid
        P_Free[物理页 P_free <br> 空白页]:::empty
    end

    %% --- 流程线条 ---
    LBA -- "<span style='font-size:18px;'>1. 修改请求</span>" --> MapTable
    MapTable -- "<span style='font-size:18px;'>2. 异地写入</span>" --> P_New
    MapTable -- "<span style='font-size:18px;'>3. 标记无效</span>" --> P_Old
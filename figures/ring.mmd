---
config:
  layout: dagre
---
flowchart TB
    %% --- 样式定义 (保留原色，锁定字号) ---
    classDef process fill:#f5f5f5,stroke:#666,stroke-width:2px,color:#333,font-size:18px;
    classDef memory fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#333,font-size:18px;
    classDef flash fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#333,font-size:18px;
    classDef discard fill:#f8cecc,stroke:#b85450,stroke-width:2px,stroke-dasharray: 5 5,color:#b85450,font-size:18px;
    classDef trigger fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#333,font-size:18px;

 subgraph LogicalMerge ["<div style='margin-bottom:25px; font-size:22px; font-weight:bold;'>内存逻辑覆写</div>"]
    direction LR
        Index{"哈希索引查找"}:::memory
        Hit["极热页命中<br>检测到 P1 已存在"]:::memory
        Overwrite["原地覆写更新<br>V3 覆盖 V2 覆盖 V1"]:::memory
        Discard("中间态 V1, V2<br>被过滤丢弃"):::discard
        Miss["新页分配<br>写入 P2"]:::memory
        Buffer["环形缓冲区<br>仅驻留最终态: P1_v3, P2"]:::memory
  end

 subgraph PhysicalMerge ["<div style='margin-bottom:25px; font-size:22px; font-weight:bold;'>物理落盘合并</div>"]
    direction LR
        Trigger(("阈值触发<br>空间80% / 时间超时")):::trigger
        Sort["LBA 地址排序<br>随机写 -> 顺序流"]:::flash
        BatchWrite["Flash 物理层<br>大块顺序写入"]:::flash
  end

    %% --- 连线逻辑 (完全保留原始文字) ---
    Index -- "<span style='font-size:18px;'>存在</span>" --> Hit
    Hit --> Overwrite
    Overwrite -.-> Discard
    Overwrite --> Buffer
    Index -- "<span style='font-size:18px;'>不存在</span>" --> Miss
    Miss --> Buffer
    Trigger --> Sort
    Sort --> BatchWrite
    
    Input("业务随机写入流<br>时间序: P1_v1 -> P2 -> P1_v2 -> P1_v3"):::process --> LogicalMerge
    LogicalMerge --> PhysicalMerge

    %% 样式微调
    style Discard stroke-width:2px
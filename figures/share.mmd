%%{init: { "theme": "base", "flowchart": { "defaultRenderer": "elk" } } }%%
flowchart TB
    %% --- 样式定义 (严格保留原色与字号) ---
    classDef kernel fill:#ffebee,stroke:#b71c1c,stroke-width:2px,color:#000,font-size:18px;
    classDef user fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000,font-size:18px;
    classDef memory fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000,font-size:18px;
    classDef data fill:#ffcdd2,stroke:#c62828,stroke-width:2px,color:#000,font-size:18px;
    classDef obsolete fill:#f5f5f5,stroke:#9e9e9e,color:#757575,font-size:18px;

    %% --- 顶部：内核态与用户态并排 ---
    subgraph Top_Wrapper ["&nbsp;"]
        direction LR
        
        subgraph Host_OS_KVM ["<div style='min-width:350px; margin-bottom:20px; font-size:22px; font-weight:bold;'>内核态KVM</div>"]
            direction TB
            KVM_Mod["KVM 内核模块"]:::kernel
            Kernel_Thread["扫描线程<br>周期性遍历页表"]:::kernel
            KVM_Mod --> Kernel_Thread
        end

        subgraph User_Space_QEMU ["<div style='min-width:350px; margin-bottom:20px; font-size:22px; font-weight:bold;'>用户态QEMU</div>"]
            direction TB
            QEMU_Proc["QEMU 用户态进程"]:::user
            Decision_Thread["快照决策线程<br>直接读取热度"]:::user
            QEMU_Proc --> Decision_Thread
        end
    end

    %% --- 底部：内存访问层沉底 ---
    subgraph Memory_Access ["<div style='min-width:700px; margin-bottom:20px; font-size:22px; font-weight:bold;'>内存访问层</div>"]
        direction LR
        Hot_Bitmap["热度位图<br>维护在 kvm_memory_slot"]:::memory
        Mem_Map["Linux mmap 机制"]:::data
    end

    %% --- 原始连线逻辑与文字 (完全保留) ---
    Kernel_Thread -- "<span style='font-size:18px;'>1. 更新热度位图</span>" --> Hot_Bitmap
    Hot_Bitmap -- "<span style='font-size:18px;'>2. mmap 映射</span>" --> Mem_Map
    Mem_Map -- "<span style='font-size:18px;'>3. 零拷贝</span>" --> Decision_Thread
    
    Kernel_Thread -. "<span style='font-size:18px;'>传统开销</span>" .-> System_Call["传统方式: ioctl"]:::obsolete
    System_Call -. "<span style='font-size:18px;'>传统获取</span>" .-> Decision_Thread
    Decision_Thread -- "<span style='font-size:18px;'>通过共享内存获取</span>" --> Hot_Bitmap

    %% 样式隐藏
    style Top_Wrapper fill:none,stroke:none
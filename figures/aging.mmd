%%{init: { "theme": "", "flowchart": { "defaultRenderer": "elk" } } }%%
flowchart TB
    %% --- 样式定义 ---
    classDef step fill:#b3e5fc,stroke:#01579b,stroke-width:2px,font-size:22px;
    classDef decision fill:#ffcdd2,stroke:#c62828,stroke-width:2px,font-size:22px;
    classDef state fill:#e8f5e9,stroke:#388e3c,stroke-width:2px,font-size:22px;
    classDef update fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,font-size:22px;

    subgraph s1 ["<div style='margin-bottom:30px; font-size:22px; font-weight:bold;'>自适应热点感知逻辑</div>"]
        direction TB
        Start["开始：每一扫描周期"]:::step

        %% 第一部分：位运算老化
        subgraph subGraph0 ["<div style='min-width:700px; margin-bottom:20px; font-size:20px; font-weight:bold;'>老化与更新</div>"]
            direction LR
            Old_S["页面旧状态 S_old<br>8 bit"]:::state
            H_Bit["硬件访问位 H_bit<br>PTE 读取"]:::state
            Aging_Shift[("S_old << 1")]:::step
            New_LSB["| H_bit<br>注入最新状态"]:::step
            Masking["& M_N<br>N位截断"]:::step
            S_New["页面新状态 S_new<br>滑动窗口 N"]:::state
            
            Old_S --> Aging_Shift --> New_LSB
            H_Bit --> New_LSB
            New_LSB --> Masking --> S_New
        end

        %% 第二部分：动态 N 调节
        subgraph Dynamic_N_Adjustment ["<div style='margin-bottom:20px; font-size:20px; font-weight:bold;'>动态调节热点难度</div>"]
            direction TB
            R_Hot["统计极热页面比例 R_hot"]:::step
            Hot_Decision{"R_hot 是否在合理区间?"}:::decision
            
            N_Up["N = N + 1<br>增加监测难度"]:::update
            N_Down["N = N - 1<br>降低监测难度"]:::update
            N_Stable["保持 N 不变"]:::update
            
            New_Mask["更新掩码 M_N"]:::update

            R_Hot --> Hot_Decision
            Hot_Decision -- "<span style='font-size:22px;'>R_hot > 5%</span>" --> N_Up
            Hot_Decision -- "<span style='font-size:22px;'>R_hot < 0.1%</span>" --> N_Down
            Hot_Decision -- "<span style='font-size:22px;'>0.1% <= R_hot <= 5%</span>" --> N_Stable
            N_Up & N_Down & N_Stable --> New_Mask
        end

        %% 第三部分：策略映射
        subgraph Strategy_Mapping ["<div style='min-width:700px; margin-bottom:20px; font-size:20px; font-weight:bold;'>策略映射</div>"]
            direction LR
            S_New_Map("检查 S_new 值"):::state
            Strategy_Hot["极热页面<br>停机阶段保存"]:::decision
            Strategy_Warm["温热页面<br>启用 COW 机制"]:::decision
            Strategy_Cold["冷寂页面<br>后台低优先级保存"]:::decision
            
            S_New_Map -- "<span style='font-size:22px;'>S_new = 2^N - 1</span>" --> Strategy_Hot
            S_New_Map -- "<span style='font-size:22px;'>0 < S_new < 2^N-1</span>" --> Strategy_Warm
            S_New_Map -- "<span style='font-size:22px;'>S_new = 0</span>" --> Strategy_Cold
        end

        End["迭代至下一周期"]:::step

        %% 主流程连接
        Start --> subGraph0
        S_New --> R_Hot
        S_New --> Strategy_Mapping
        New_Mask --> End
        Strategy_Hot & Strategy_Warm & Strategy_Cold --> End
    end
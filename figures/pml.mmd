%%{init: { "theme": "base", "flowchart": { "defaultRenderer": "elk" } } }%%
graph TB
    %% --- 样式定义 ---
    classDef guest fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000,font-size:18px;
    classDef trap fill:#ffcdd2,stroke:#c62828,stroke-width:2px,color:#000,font-size:18px;
    classDef kvm fill:#ffebee,stroke:#b71c1c,stroke-width:2px,color:#000,font-size:18px;
    classDef hw fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000,font-size:18px;
    classDef mem fill:#f5f5f5,stroke:#616161,stroke-width:2px,color:#000,font-size:18px;

    subgraph SW_Track ["<div style='min-width:400px; margin-bottom:20px; font-size:22px; font-weight:bold;'>基于写保护的软件追踪</div>"]
        direction TB
        SW_Write(Guest 发起写入操作):::guest
        Exception{触发 EPT Violation}:::trap
        
        subgraph Overhead ["<div style='margin-bottom:15px; font-size:20px;'>高昂开销路径</div>"]
            VMExit[VM Exit: 暂停 vCPU <br> 上下文切换 / TLB 刷新]:::kvm
            Handle[KVM 捕获异常 <br> 置位脏页位图 / 解除写保护]:::kvm
            Resume[VM Resume: 恢复 vCPU]:::kvm
        end
        
        SW_Mem[(物理内存写入)]:::mem

        SW_Write --> Exception
        Exception -- "<span style='font-size:18px;'>陷入内核</span>" --> VMExit
        VMExit --> Handle
        Handle --> Resume
        Resume --> SW_Mem
    end

    subgraph HW_Track ["<div style='min-width:400px; margin-bottom:20px; font-size:22px; font-weight:bold;'>硬件辅助追踪 (PML)</div>"]
        direction TB
        HW_Write(Guest 发起写入操作):::guest
        
        subgraph Pipeline ["<div style='margin-bottom:15px; font-size:20px;'>硬件流水线处理</div>"]
            HW_Logic[MMU / 硬件逻辑介入 <br> 自动置位或写入 PML Log]:::hw
            NoExit[无 VM Exit <br> vCPU 持续运行]:::hw
        end
        
        HW_Mem[(物理内存写入)]:::mem

        HW_Write -- "<span style='font-size:18px;'>硬件原子操作</span>" --> HW_Logic
        HW_Logic -- "<span style='font-size:18px;'>流水线并行</span>" --> NoExit
        NoExit --> HW_Mem
        
        %% 异步扫描逻辑
        Hypervisor[Hypervisor <br> 异步轮询/批处理]:::guest
        HW_Logic -. "<span style='font-size:18px;'>周期性收集</span>" .-> Hypervisor
    end

    %% --- 视觉对比强调 ---
    style Overhead fill:#fff5f5,stroke:#d32f2f,stroke-width:2px,stroke-dasharray: 5 5
    style Pipeline fill:#f1f8e9,stroke:#388e3c,stroke-width:2px
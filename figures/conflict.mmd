%%{init: { "theme": "base", "flowchart": { "defaultRenderer": "elk" } } }%%
graph TB
    %% --- 样式定义 ---
    classDef constraint fill:#f5f5f5,stroke:#616161,stroke-width:2px,color:#000,font-size:18px;
    classDef mech fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000,font-size:18px;
    classDef conflict fill:#fff9c4,stroke:#fbc02d,stroke-width:2px,color:#000,font-size:18px;
    classDef fail fill:#ffcdd2,stroke:#c62828,stroke-width:2px,color:#000,font-size:18px;

    %% --- 顶部：改为垂直排列以收缩宽度 ---
    subgraph Edge_Env ["<div style='margin-bottom:20px; font-size:22px; font-weight:bold;'>边缘节点资源硬约束</div>"]
        direction TB
        Constraint_CPU[计算资源受限 ]:::constraint
        Constraint_IO[存储 I/O 带宽受限 ]:::constraint
    end

    %% --- 下方区域：强制左右并排 ---
    subgraph Bottom_Area ["&nbsp;"]
        direction LR

        %% --- 左侧：预拷贝失效路径 ---
        subgraph PreCopy_Path ["<div style='margin-bottom:20px; font-size:22px; font-weight:bold;'>预拷贝机制失效</div>"]
            direction TB
            Pre_Start(开启预拷贝):::mech
            Write_Load(写密集型负载 <br> 脏页产生速率 > 保存速率):::conflict
            
            Congestion{I/O 通道拥塞}:::conflict
            Non_Converge[迭代不收敛 <br> 强制退化为停止并拷贝]:::fail
            
            Pre_Start --> Write_Load
            Write_Load -- "<span style='font-size:18px;'>挤占带宽</span>" --> Congestion
            Congestion --> Non_Converge
        end

        %% --- 右侧：后拷贝失效路径 ---
        subgraph PostCopy_Path ["<div style='margin-bottom:20px; font-size:22px; font-weight:bold;'>后拷贝机制失效</div>"]
            direction TB
            Post_Start(开启后拷贝):::mech
            Page_Faults(密集缺页异常 <br> VM Exit):::conflict
            
            Contention{CPU 资源争抢 }:::conflict
            Jitter[严重业务抖动 <br> ]:::fail

            Post_Start --> Page_Faults
            Page_Faults -- "<span style='font-size:18px;'>消耗 CPU</span>" --> Contention
            Contention --> Jitter
        end
    end

    %% --- 跨层级连接 ---
    Constraint_IO ==>|"<span style='font-size:18px;'>限制保存速率上限</span>"| Congestion
    Constraint_CPU ==>|"<span style='font-size:18px;'>限制处理能力</span>"| Contention

    %% 样式隐藏
    style Bottom_Area fill:none,stroke:none
%%{init: {"flowchart": {"defaultRenderer": "elk"}} }%%
graph TB
    %% 样式定义
    classDef addr fill:#e1f5fe,stroke:#01579b,stroke-width:2px,color:#000,font-size:18px;
    classDef table fill:#ffebee,stroke:#b71c1c,stroke-width:2px,color:#000,font-size:18px;
    classDef hw fill:#eeeeee,stroke:#616161,stroke-width:2px,color:#000,font-size:18px;
    classDef final fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000,font-size:18px;

    %% 客户机环境大方块 - 标题 22px
    subgraph Guest_Context ["<div style='min-width:400px; padding:10px; margin-bottom:20px; font-size:22px; font-weight:bold;'>客户机环境</div>"]
        direction LR
        GVA[客户机虚拟地址 GVA]:::addr
        GuestPT[阶段1: 客户机页表]:::table
        GVA -- "<span style='font-size:18px;'>软件映射</span>" --> GuestPT
    end

    %% 硬件辅助虚拟化层大方块 - 标题 22px
    subgraph Hypervisor_Hardware ["<div style='min-width:600px; padding:10px; margin-bottom:20px; font-size:22px; font-weight:bold;'>硬件辅助虚拟化层</div>"]
        direction LR
        GPA[客户机物理地址 GPA]:::addr
        EPT[扩展页表 EPT/Stage-2]:::table
        DirtyBit[硬件脏标记与访问位]:::hw
        HPA[宿主机物理地址 HPA]:::final

        %% 水平箭头主路径 - 字号 18px
        GPA -- "<span style='font-size:18px;'>硬件遍历</span>" --> EPT
        EPT -- "<span style='font-size:18px;'>最终映射</span>" --> HPA

        %% 脏标记虚线箭头
        EPT -. "<span style='font-size:18px;'>写入触发更新</span>" .-> DirtyBit
        DirtyBit -. "<span style='font-size:18px;'>辅助判断</span>" .-> HPA
    end

    %% 外部箭头
    Guest_Context -- "<span style='font-size:18px;'>内存访问请求</span>" --> Hypervisor_Hardware